<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#12141A">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1B1D22"
        android:paddingStart="8dp"
        android:paddingEnd="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:elevation="4dp">

        <EditText
            android:id="@+id/urlBar"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="#25282E"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:hint="ابحث أو اكتب رابطاً"
            android:textColorHint="#8A93A6"
            android:textColor="#E8EAED"
            android:textSize="13sp"
            android:singleLine="true"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:selectAllOnFocus="true" />

        <TextView
            android:id="@+id/btnGo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="↵"
            android:textColor="#8A93A6"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvLang"
            android:layout_width="42dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:background="#25282E"
            android:text="AR"
            android:textColor="#6E96FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnTr"
            android:layout_width="46dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="译"
            android:textColor="#8A93A6"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCfg"
            android:layout_width="42dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="⚙"
            android:textColor="#8A93A6"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#16181E"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="جاهز · اضغط 译 للترجمة · ضغط مطوّل = تفعيل تلقائي لهالموقع"
            android:textColor="#8A93A6"
            android:textSize="10sp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tvMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ثنائي"
            android:textColor="#6E96FF"
            android:textSize="10sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progress="0"
        android:visibility="gone" />

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
