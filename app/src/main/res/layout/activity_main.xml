<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:id="@+id/screenHost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ===================== المفضلة (الرئيسية) ===================== -->
        <ScrollView
            android:id="@+id/homeScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg"
            android:fillViewport="true">
            <LinearLayout
                android:id="@+id/homeRoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="26dp" />
        </ScrollView>

        <!-- ===================== اكتشف ===================== -->
        <ScrollView
            android:id="@+id/discoverScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/discoverRoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="26dp" />
        </ScrollView>

        <!-- ===================== الترجمة (نص) ===================== -->
        <ScrollView
            android:id="@+id/textScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/textRoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="26dp" />
        </ScrollView>

        <!-- ===================== المتصفح ===================== -->
        <LinearLayout
            android:id="@+id/browserScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/surface"
                android:paddingStart="8dp"
                android:paddingEnd="6dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:elevation="3dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBack"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="‹"
                    android:textSize="24sp"
                    android:textColor="@color/on_surface" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="22dp"
                    app:cardBackgroundColor="@color/surface2"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <EditText
                        android:id="@+id/urlBar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:hint="ابحث أو اكتب رابطاً"
                        android:textColorHint="@color/muted"
                        android:textColor="@color/on_surface"
                        android:textSize="14sp"
                        android:singleLine="true"
                        android:imeOptions="actionGo"
                        android:inputType="textUri"
                        android:selectAllOnFocus="true"
                        android:importantForAutofill="no" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGo"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_go"
                    app:iconSize="21dp"
                    app:iconPadding="0dp"
                    app:iconGravity="textStart"
                    app:iconTint="@color/on_surface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenu"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_settings"
                    app:iconSize="21dp"
                    app:iconPadding="0dp"
                    app:iconGravity="textStart"
                    app:iconTint="@color/on_surface" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/surface"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="جاهز"
                    android:textColor="@color/muted"
                    android:textSize="11sp"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvChip"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:gravity="center"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="AR"
                    android:textColor="@color/accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/accent"
                android:visibility="invisible" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <WebView
                    android:id="@+id/web"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                    android:id="@+id/fabTr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="16dp"
                    android:alpha="0.96"
                    android:text="ترجمة"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    app:backgroundTint="@color/accent"
                    app:elevation="8dp"
                    app:icon="@drawable/ic_nav_text"
                    app:iconPadding="8dp"
                    app:iconSize="20dp"
                    app:iconTint="#FFFFFF" />
            </FrameLayout>
        </LinearLayout>

        <!-- ===================== قيد البناء ===================== -->
        <LinearLayout
            android:id="@+id/soonScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/bg"
            android:padding="32dp"
            android:visibility="gone">

            <TextView android:id="@+id/soonIcon" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="🚧" android:textSize="52sp" />
            <TextView android:id="@+id/soonTitle" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="18dp"
                android:text="قيد البناء" android:textColor="@color/on_surface"
                android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/soonBody" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:gravity="center" android:lineSpacingExtra="4dp" android:text=""
                android:textColor="@color/muted" android:textSize="13sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/soonAction"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="22dp" android:text="افتح" android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="12dp"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="@color/nav_item"
        app:itemTextColor="@color/nav_item"
        app:itemActiveIndicatorStyle="@style/NavIndicator"
        app:menu="@menu/bottom_nav" />

</LinearLayout>
